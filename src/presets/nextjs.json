{
  "extends": ["preset:recommended"],
  "rules": {
    "circular-dependency": "error",
    "unused-export": {
      "level": "error",
      "options": {
        "entryPoints": [
          "**/app/**/page.*",
          "**/app/**/layout.*",
          "**/app/**/route.*",
          "**/app/**/template.*",
          "**/pages/**"
        ]
      }
    }
  }
}
